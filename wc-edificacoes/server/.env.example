# ============ WC Edificações — configuração do servidor ============
# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

NODE_ENV=production
PORT=3000

# PostgreSQL (use um usuário próprio da aplicação, sem privilégio de superusuário)
DATABASE_URL=postgres://wc:TROQUE_ESTA_SENHA@localhost:5432/wc_edificacoes
# true se o banco exigir SSL (Neon, Supabase, RDS, Render...)
DATABASE_SSL=false

# Endereço público do site (separe vários por vírgula). Em produção: só https://
ALLOWED_ORIGINS=https://www.wcedificacoes.com.br,https://wcedificacoes.com.br

# Quantos proxies reversos ficam na frente do Node (Nginx = 1, Nginx + Cloudflare = 2).
# Errar este valor quebra o rate limit por IP.
TRUST_PROXY=1

# Segredo aleatório (mín. 32 caracteres) para anonimizar IPs. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
IP_HASH_SECRET=

# Sessão do painel
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Pasta do front-end compilado (npm run build no client)
CLIENT_DIST=../client/dist

# (Opcional) Cloudflare Turnstile anti-robô no formulário de orçamento.
# Coloque a chave secreta aqui e a chave pública em client/.env (VITE_TURNSTILE_SITEKEY).
TURNSTILE_SECRET=

# Fuso horário dos relatórios do painel
REPORT_TIMEZONE=America/Sao_Paulo

LOG_LEVEL=info
